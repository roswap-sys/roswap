# roswap 在测试内核里需要的配置。编译检查和虚拟机内核共用这一份。
# RDMA 相关全部编进内核，虚拟机里不用 modprobe，也不用装模块。
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG is not set
# CONFIG_WERROR is not set
# CONFIG_DEBUG_INFO_BTF is not set
# 不要调试信息：编译快一倍，内核树小到能放进 Actions 缓存。
# 5.18 之前是 DEBUG_INFO 开关，之后是 DEBUG_INFO_NONE 选项，两个都写上。
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_SWAP=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PCI=y
CONFIG_VETH=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_INFINIBAND=y
CONFIG_INFINIBAND_USER_ACCESS=y
CONFIG_INFINIBAND_ADDR_TRANS=y
CONFIG_RDMA_RXE=y
