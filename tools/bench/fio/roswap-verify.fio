# 对 ${ROSWAP_DEV} 做校验，设备至少 1GB，且不能正处于 swapon。
# 4 个 randrw job 用 offset_increment 各占 256MB，互不覆盖。
[global]
filename=${ROSWAP_DEV}
ioengine=libaio
direct=1
bs=4k
rw=randrw
rwmixread=50
iodepth=16
verify=crc32c
verify_fatal=1
group_reporting=1

[randrw]
stonewall
numjobs=4
size=256M
offset_increment=256M

[mixed]
stonewall
bs=128k
iodepth=4
numjobs=1
offset=0
size=64M
